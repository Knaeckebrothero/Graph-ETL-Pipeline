{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kgbench.local/spec/kgc-trace-v1.schema.json",
  "title": "kgc-trace/1 — construction-run trace record (Thesis B instrumentation specification, draft for F3)",
  "description": "One JSON object per line. Harness-neutral: a record is derived from the raw log of any construction harness (kgbench, SRW). Envelope fields are required on every record; kind-specific fields are defined in $defs. Additional fields are allowed everywhere (Thesis B adds fields freely; added fields never change the meaning of the ones defined here). Missing numeric values are null and mean unknown, never zero.",
  "type": "object",
  "required": [
    "trace_format",
    "record_id",
    "seq",
    "kind",
    "run_id",
    "source_id",
    "ts",
    "origin"
  ],
  "properties": {
    "trace_format": {
      "const": "kgc-trace/1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^t[0-9]{6,}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "1-based position in the trace; strictly increasing"
    },
    "kind": {
      "enum": [
        "run_start",
        "run_end",
        "source_start",
        "source_end",
        "model_call",
        "tool_call",
        "insert_attempt",
        "item",
        "reconciliation",
        "intake",
        "gap_trigger"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "null only on run-level records (run_start, run_end, model_call without a current source)"
    },
    "ts": {
      "$ref": "#/$defs/timestamp",
      "description": "UTC time the recorded thing ended (ISO 8601)"
    },
    "origin": {
      "$ref": "#/$defs/origin"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "run_start"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/run_start"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "run_end"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/run_end"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "source_start"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/source_start"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "source_end"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/source_end"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "model_call"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/model_call"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tool_call"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/tool_call"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "insert_attempt"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/insert_attempt"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "item"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/item"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "reconciliation"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/reconciliation"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "intake"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/intake"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "gap_trigger"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/gap_trigger"
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_ref": {
      "type": "object",
      "description": "Reference to a content-hashed file in the run directory (full, untruncated payload). locator narrows the reference inside the file (e.g. a tool_use id).",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "nullable_artifact_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/artifact_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "type": "object",
      "description": "Where this record was derived from, for the forward trace back to the raw log.",
      "required": [
        "harness",
        "raw_event_ids"
      ],
      "properties": {
        "harness": {
          "type": "string",
          "description": "kgbench | srw | ..."
        },
        "harness_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_format": {
          "type": [
            "string",
            "null"
          ],
          "description": "e.g. kgbench-event/1"
        },
        "raw_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derived": {
          "type": "boolean",
          "description": "true when the record aggregates or infers (e.g. source_end), false when it mirrors one raw event",
          "default": false
        }
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "type",
            "message"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "status_code": {
              "type": [
                "integer",
                "null"
              ]
            },
            "retryable": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      ]
    },
    "usage": {
      "description": "Token counts as reported by the provider. null = provider did not report (unknown, not zero).",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "properties": {
            "input_tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "output_tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "reasoning_tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "cache_read_tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "cache_write_tokens": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      ]
    },
    "usage_source": {
      "enum": [
        "provider_reported",
        "synthetic_mock_estimate",
        "unavailable"
      ]
    },
    "resources": {
      "type": "object",
      "required": [
        "wall_clock_ms",
        "tokens",
        "cost"
      ],
      "properties": {
        "wall_clock_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "tokens": {
          "type": "object",
          "required": [
            "complete",
            "known",
            "attempts",
            "attempts_missing_usage",
            "usage_sources"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "attempts": {
              "type": "integer"
            },
            "attempts_missing_usage": {
              "type": "integer"
            },
            "known": {
              "type": "object"
            },
            "known_total": {
              "type": "integer"
            },
            "usage_sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "cost": {
          "type": "object",
          "required": [
            "value",
            "complete",
            "price_table_id"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "complete": {
              "type": "boolean"
            },
            "currency": {
              "type": [
                "string",
                "null"
              ]
            },
            "price_table_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "failure_class": {
      "description": "Thesis B failure taxonomy v0.1 (draft; frozen with the methodology, not at F3)",
      "enum": [
        "none",
        "transport",
        "provider_permanent",
        "budget_exhausted",
        "output_truncated",
        "validator_persistent_reject",
        "valid_not_persisted",
        "never_validated",
        "harness_error",
        "cancelled",
        "unknown"
      ]
    },
    "run_status": {
      "enum": [
        "completed",
        "step_limit",
        "tool_limit",
        "output_truncated",
        "transport_failed",
        "provider_error",
        "agent_exception",
        "cancelled",
        "unknown"
      ]
    },
    "run_start": {
      "required": [
        "schema_id",
        "arm",
        "agent_config_id",
        "model",
        "prompt_hashes",
        "tools_hash",
        "container_digests",
        "sample_manifest_sha256",
        "launcher",
        "code",
        "initial_graph_hash",
        "pilot"
      ],
      "properties": {
        "schema_id": {
          "type": "string"
        },
        "schema_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "arm": {
          "enum": [
            "PG",
            "RDF",
            "kgbench-json"
          ]
        },
        "agent_config_id": {
          "type": "string",
          "description": "A0-v1, A1-v1, ... or a kgbench config id"
        },
        "model": {
          "type": "object",
          "required": [
            "requested_model_id",
            "provider"
          ],
          "properties": {
            "requested_model_id": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "provider_kind": {
              "type": [
                "string",
                "null"
              ],
              "description": "llm | scripted_mock"
            },
            "protocol": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "prompt_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tools_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "container_digests": {
          "type": [
            "object",
            "null"
          ]
        },
        "sample_manifest_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "launcher": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "type": "object",
          "properties": {
            "git_commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "git_dirty": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "initial_graph_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "pilot": {
          "type": "boolean"
        },
        "settings": {
          "type": "object"
        }
      }
    },
    "run_end": {
      "required": [
        "status",
        "final_graph_hash",
        "global_validator",
        "resources",
        "counts",
        "failure_class",
        "error"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/run_status"
        },
        "final_graph_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "global_validator": {
          "type": [
            "object",
            "null"
          ],
          "description": "end-of-run validator results (Thesis A's global rules); null when the harness has none"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "counts": {
          "type": "object",
          "required": [
            "model_operations",
            "model_attempts",
            "tool_calls",
            "insert_attempts",
            "items",
            "items_persisted",
            "items_abandoned"
          ],
          "additionalProperties": {
            "type": "integer"
          }
        },
        "failure_class": {
          "$ref": "#/$defs/failure_class"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    },
    "source_start": {
      "required": [
        "modality",
        "source_sha256",
        "segments_total",
        "manifest"
      ],
      "properties": {
        "modality": {
          "type": "string",
          "description": "text | csv | html | pdf | ... (Thesis A's modality strata map onto this)"
        },
        "source_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "segments_total": {
          "type": [
            "integer",
            "null"
          ]
        },
        "manifest": {
          "$ref": "#/$defs/unit_manifest"
        }
      }
    },
    "source_end": {
      "required": [
        "final_status",
        "fatal_failure",
        "attempts",
        "rejects",
        "accepted",
        "abandoned_items",
        "items",
        "max_retry_index_until_acceptance",
        "resources",
        "failure_class"
      ],
      "properties": {
        "final_status": {
          "enum": [
            "completed",
            "partial",
            "abandoned",
            "fatal",
            "unknown"
          ]
        },
        "fatal_failure": {
          "type": "boolean"
        },
        "attempts": {
          "type": "integer",
          "description": "insert attempts on this source"
        },
        "rejects": {
          "type": "integer",
          "description": "insert attempts the validator rejected"
        },
        "accepted": {
          "type": "integer",
          "description": "insert attempts the engine wrote"
        },
        "abandoned_items": {
          "type": "integer"
        },
        "items": {
          "type": "integer"
        },
        "max_retry_index_until_acceptance": {
          "type": [
            "integer",
            "null"
          ],
          "description": "highest retry index among accepted attempts; null when nothing was accepted"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "failure_class": {
          "$ref": "#/$defs/failure_class"
        }
      }
    },
    "model_call": {
      "required": [
        "operation_id",
        "attempt_index",
        "status",
        "requested_model_id",
        "response_model_id",
        "stop_reason",
        "usage",
        "usage_source",
        "latency_ms",
        "tools_requested",
        "artifacts",
        "error",
        "sampling",
        "response_fingerprint"
      ],
      "properties": {
        "operation_id": {
          "type": "string"
        },
        "attempt_index": {
          "type": "integer",
          "minimum": 1,
          "description": "transport attempt within the logical call"
        },
        "status": {
          "enum": [
            "ok",
            "transient_error",
            "permanent_error"
          ]
        },
        "requested_model_id": {
          "type": "string"
        },
        "response_model_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "model id returned by the provider (shared minimum: provider model ID per call)"
        },
        "response_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "stop_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "usage_source": {
          "$ref": "#/$defs/usage_source"
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "tools_requested": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "object",
          "required": [
            "request",
            "response"
          ],
          "properties": {
            "request": {
              "$ref": "#/$defs/nullable_artifact_ref"
            },
            "response": {
              "$ref": "#/$defs/nullable_artifact_ref"
            }
          }
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "sampling": {
          "$ref": "#/$defs/sampling"
        },
        "response_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "description": "provider fingerprint of the serving snapshot (e.g. system_fingerprint), per call; null if the provider returns none"
        }
      }
    },
    "tool_call": {
      "required": [
        "operation_id",
        "model_operation_id",
        "step_index",
        "tool_name",
        "tool_role",
        "status",
        "is_error",
        "duration_ms",
        "payload_sha256",
        "artifacts",
        "item_ids",
        "error"
      ],
      "properties": {
        "operation_id": {
          "type": "string"
        },
        "model_operation_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "the model call that requested this tool"
        },
        "step_index": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based ordinal of the tool call in the run"
        },
        "tool_name": {
          "type": "string"
        },
        "tool_role": {
          "enum": [
            "read",
            "register",
            "reconcile",
            "validate",
            "revise",
            "write",
            "other"
          ]
        },
        "status": {
          "type": "string"
        },
        "is_error": {
          "type": "boolean"
        },
        "duration_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "payload_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ],
          "description": "sha256 of the canonical JSON of the tool arguments; null when the harness did not store them"
        },
        "artifacts": {
          "type": "object",
          "required": [
            "arguments",
            "result"
          ],
          "properties": {
            "arguments": {
              "$ref": "#/$defs/nullable_artifact_ref"
            },
            "result": {
              "$ref": "#/$defs/nullable_artifact_ref"
            }
          }
        },
        "item_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    },
    "insert_attempt": {
      "description": "Thesis A's per-insert-attempt record. One per (item, revision) submitted for validation and writing.",
      "required": [
        "attempt_id",
        "step_index",
        "retry_index",
        "item_id",
        "item_revision",
        "tool_name",
        "modality",
        "payload_sha256",
        "validator",
        "engine",
        "latency_ms",
        "tokens",
        "cost",
        "model_operation_id"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "description": "{run_id}:s{step_index}:{item_id}:r{retry_index}; unique per (item, revision) even when one tool call validates several items. Thesis A's draft scheme (run_id + step index + attempt index) has no item part; to settle at F3."
        },
        "step_index": {
          "type": "integer",
          "minimum": 1
        },
        "retry_index": {
          "type": "integer",
          "minimum": 0,
          "description": "0 = first submission of the item; n = n-th self-correction"
        },
        "item_id": {
          "type": "string"
        },
        "item_revision": {
          "type": "integer",
          "minimum": 0
        },
        "tool_name": {
          "type": "string"
        },
        "modality": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "validator": {
          "type": "object",
          "required": [
            "result",
            "rejects"
          ],
          "properties": {
            "result": {
              "enum": [
                "pass",
                "reject",
                "not_run"
              ]
            },
            "rejects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "rule_id",
                  "element",
                  "expected",
                  "found"
                ],
                "properties": {
                  "rule_id": {
                    "type": "string"
                  },
                  "category": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "element": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "expected": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "found": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "message": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "engine": {
          "type": "object",
          "required": [
            "result",
            "assertion_ids",
            "entities_created"
          ],
          "properties": {
            "result": {
              "enum": [
                "written",
                "duplicate",
                "refused",
                "failed",
                "unconfirmed",
                "not_attempted"
              ]
            },
            "assertion_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "entities_created": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "tokens": {
          "type": "object",
          "required": [
            "attribution",
            "usage"
          ],
          "properties": {
            "attribution": {
              "enum": [
                "exact",
                "none"
              ],
              "description": "exact only when the harness can attribute one model turn to this attempt"
            },
            "usage": {
              "$ref": "#/$defs/usage"
            }
          }
        },
        "cost": {
          "type": "object",
          "required": [
            "value",
            "complete"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "complete": {
              "type": "boolean"
            },
            "currency": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "model_operation_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "item": {
      "description": "Thesis B's candidate lifecycle: what the agent proposed before the validator saw it, and what became of it.",
      "required": [
        "item_id",
        "event",
        "revision"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "event": {
          "enum": [
            "created",
            "validated",
            "revised",
            "revision_refused",
            "persisted",
            "abandoned"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "produced_by": {
          "enum": [
            "extract",
            "revise",
            null
          ]
        },
        "mentions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "surface",
              "type"
            ],
            "properties": {
              "role": {
                "enum": [
                  "subject",
                  "object"
                ]
              },
              "surface": {
                "type": "string"
              },
              "type": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "predicate": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "source_id",
                "locator",
                "quote"
              ],
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "locator": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "quote": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "validation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "valid",
                "categories_ok",
                "errors"
              ],
              "properties": {
                "valid": {
                  "type": "boolean"
                },
                "categories_ok": {
                  "type": "object"
                },
                "errors": {
                  "type": "array"
                }
              }
            }
          ]
        },
        "correction": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "attempt_number",
                "budget",
                "remaining"
              ],
              "properties": {
                "attempt_number": {
                  "type": "integer"
                },
                "budget": {
                  "type": "integer"
                },
                "remaining": {
                  "type": "integer"
                },
                "rationale": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "assertion_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "failure_class": {
          "oneOf": [
            {
              "$ref": "#/$defs/failure_class"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact": {
          "$ref": "#/$defs/nullable_artifact_ref"
        }
      }
    },
    "reconciliation": {
      "required": [
        "item_id",
        "role",
        "mention",
        "stage",
        "decision",
        "method",
        "entity_id",
        "candidates"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "subject",
            "object"
          ]
        },
        "mention": {
          "type": "object",
          "required": [
            "surface",
            "type"
          ],
          "properties": {
            "surface": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "stage": {
          "enum": [
            "match",
            "write"
          ],
          "description": "match = explicit matching step before writing; write = resolution performed by the write tool"
        },
        "decision": {
          "enum": [
            "reuse_existing",
            "create_new",
            "unresolved",
            "contained"
          ]
        },
        "method": {
          "enum": [
            "exact",
            "fuzzy",
            "graph_query",
            "model_choice",
            "bound",
            "none"
          ]
        },
        "entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "entity_id",
              "score"
            ],
            "properties": {
              "entity_id": {
                "type": "string"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "score": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "intake": {
      "required": [
        "read_index",
        "segments_read",
        "coverage"
      ],
      "properties": {
        "read_index": {
          "type": "integer",
          "minimum": 1,
          "description": "n-th read of this source in the run"
        },
        "segments_read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage": {
          "type": "object",
          "required": [
            "read",
            "total",
            "fraction"
          ],
          "properties": {
            "read": {
              "type": "integer"
            },
            "total": {
              "type": [
                "integer",
                "null"
              ]
            },
            "fraction": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "has_more": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "gap_trigger": {
      "required": [
        "trigger",
        "item_ids",
        "detail"
      ],
      "properties": {
        "trigger": {
          "enum": [
            "source_reread",
            "schema_requested",
            "graph_queried",
            "validator_feedback"
          ]
        },
        "item_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "top_p",
        "seed",
        "reasoning_budget",
        "max_output_tokens"
      ],
      "description": "Requested sampling parameters per call (Thesis A EX-10, Draft 1h point 20 b). Field names are Thesis A's, values are the configuration's own.",
      "properties": {
        "temperature": {
          "type": [
            "number",
            "integer",
            "string",
            "null"
          ],
          "description": "requested value; the string 'not_exposed' when the pinned snapshot does not expose the parameter (provider default in force); null = unknown"
        },
        "top_p": {
          "type": [
            "number",
            "integer",
            "string",
            "null"
          ],
          "description": "requested value; the string 'not_exposed' when the pinned snapshot does not expose the parameter (provider default in force); null = unknown"
        },
        "seed": {
          "type": [
            "number",
            "integer",
            "string",
            "null"
          ],
          "description": "requested value; the string 'not_exposed' when the pinned snapshot does not expose the parameter (provider default in force); null = unknown"
        },
        "reasoning_budget": {
          "type": [
            "number",
            "integer",
            "string",
            "null"
          ],
          "description": "requested value; the string 'not_exposed' when the pinned snapshot does not expose the parameter (provider default in force); null = unknown"
        },
        "max_output_tokens": {
          "type": [
            "number",
            "integer",
            "string",
            "null"
          ],
          "description": "requested value; the string 'not_exposed' when the pinned snapshot does not expose the parameter (provider default in force); null = unknown"
        }
      }
    },
    "unit_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stratum",
        "jurisdiction",
        "authority_class",
        "bucket",
        "chunk_rule",
        "seed",
        "retrieval_date",
        "source_version_sha256"
      ],
      "description": "Per-source-unit fields of Thesis A's F2 sample manifest (EX-05, EX-16). Copied, not derived; null where the manifest has no value (kgbench runs: all null).",
      "properties": {
        "stratum": {
          "type": [
            "string",
            "null"
          ],
          "description": "modality stratum: numeric tabular | tabular-categorical | catalogue | free text"
        },
        "jurisdiction": {
          "type": [
            "string",
            "null"
          ],
          "description": "DE | DE-HE | 8-digit AGS | institution id"
        },
        "authority_class": {
          "type": [
            "string",
            "null"
          ],
          "description": "A | B | C | D (BE-06)"
        },
        "bucket": {
          "type": [
            "string",
            "null"
          ],
          "description": "development | pilot | held-out | canary"
        },
        "chunk_rule": {
          "type": [
            "string",
            "null"
          ],
          "description": "id of the rule that cut the unit at F2"
        },
        "seed": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "retrieval_date": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO 8601 date"
        },
        "source_version_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
