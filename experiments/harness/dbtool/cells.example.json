{
  "listen": "127.0.0.1:18080",
  "control_key_env": "DBTOOL_CONTROL_KEY",
  "log_dir": "dbtool-records",
  "checker": "none",
  "warn_deleted": 25,
  "remove_hooks_on_stop": true,
  "cells": {
    "dev-pg": {
      "arm": "pg",
      "uri": "bolt://127.0.0.1:17687",
      "user": "neo4j",
      "password_env": "HARNESS_NEO4J_PASSWORD",
      "database": "neo4j",
      "realisation": "S4-curated/pg",
      "tool_key_env": "DBTOOL_KEY_DEV_PG",
      "mode": "reject"
    },
    "dev-rdf": {
      "arm": "rdf",
      "endpoint": "http://127.0.0.1:13030/cell",
      "user": "admin",
      "password_env": "HARNESS_FUSEKI_PASSWORD",
      "change_log": "deploy/harness/fuseki/log/cell.rdfp",
      "realisation": "S4-curated/rdf",
      "tool_key_env": "DBTOOL_KEY_DEV_RDF",
      "mode": "reject"
    }
  }
}
