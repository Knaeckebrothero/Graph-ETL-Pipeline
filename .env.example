# Graph backends (default values are for the local containers in deploy/local/podman-compose.yml)

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev

# Postgres 18 with Apache AGE
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fessi
POSTGRES_USER=fessi
POSTGRES_PASSWORD=postgres_dev

# Apache Jena Fuseki dataset (no authentication; query at /sparql, update at /update)
FUSEKI_URL=http://localhost:3030/fessi

# LLM configuration
# Provider: "openai" (default) or "groq"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=
# OpenAI-compatible base URL override (for local llama.cpp, etc.)
LLM_BASE_URL=
# Groq-specific API key (falls back to LLM_API_KEY if unset)
GROQ_API_KEY=

# External product data APIs
# opengtindb.org — German EAN database (free registration: https://opengtindb.org/userid.php)
OPENGTINDB_QUERY_ID=
