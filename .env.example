# Neo4j configuration (default values are for local Podman container)

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# LLM configuration
# Provider: "openai" (default) or "groq"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=
# OpenAI-compatible base URL override (for local llama.cpp, etc.)
LLM_BASE_URL=
# Groq-specific API key (falls back to LLM_API_KEY if unset)
GROQ_API_KEY=
