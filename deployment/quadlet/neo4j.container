[Unit]
Description=Neo4j 5 Community (Fessi Knowledge Graph)

[Container]
Image=docker.io/neo4j:5-community
ContainerName=neo4j-etl

# Browser UI + Bolt protocol
PublishPort=7474:7474
PublishPort=7687:7687

# Persistent volumes (managed by companion .volume units)
Volume=neo4j-data.volume:/data
Volume=neo4j-logs.volume:/logs
Volume=neo4j-import.volume:/var/lib/neo4j/import

# Authentication
Environment=NEO4J_AUTH=neo4j/neo4j_dev

# APOC plugin
Environment=NEO4J_PLUGINS=["apoc"]
Environment=NEO4J_apoc_export_file_enabled=true
Environment=NEO4J_apoc_import_file_enabled=true
Environment=NEO4J_apoc_import_file_use__neo4j__config=true

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
